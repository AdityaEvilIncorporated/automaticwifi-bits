<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or moved to a new device (Android 12+ ignores allowBackup="false" for
     device-to-device transfer, so every domain is excluded explicitly; path="." = whole domain).
     Credentials are bound to this device's Keystore and session tokens must not travel. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
