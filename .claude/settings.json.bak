{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout dev)",
      "Bash(git push origin dev)",
      "Bash(git push -q origin dev)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(uv:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(docker compose:*)",
      "Bash(docker build:*)",
      "Bash(gh run:*)",
      "Bash(bash scripts/verify.sh)",
      "Bash(bash scripts/db.sh:*)",
      "Bash(bs-env.py:*)",
      "Bash(notify-human.sh:*)",
      "Bash(bs-task.py:*)",
      "Bash(repo-map.py:*)",
      "Bash(gate.sh:*)",
      "Bash(bs-secret.sh:*)",
      "Bash(need-human.sh:*)",
      "Bash(mail-otp.py:*)",
      "Bash(deploy-browser.sh:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(git tag:*)",
      "mcp__deploybrowser",
      "Bash(git push origin release-*)",
      "Bash(second-opinion.sh:*)",
      "Bash(agy-feature.py:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(curl:* | sh)",
      "Bash(curl:* | bash)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git checkout main)",
      "Bash(git merge main:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo:*)",
      "Bash(gh auth:*)",
      "Bash(gh secret:*)",
      "Bash(gh api:*)",
      "Bash(vercel:*)",
      "Bash(fly:*)",
      "Bash(flyctl:*)",
      "Bash(railway:*)",
      "Bash(aws:*)",
      "Bash(gcloud:*)",
      "Bash(ssh:*)",
      "Read(./.env.production)",
      "Read(~/.ssh/**)",
      "Read(~/.agent-secrets/**)",
      "Read(~/.claude/.credentials.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/bin/path-guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/bin/stop-gate.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/bin/on-limit.sh"
          }
        ]
      }
    ]
  }
}
